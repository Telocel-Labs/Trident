---
import Base from '../../../layouts/Base.astro';
import ErrorState from '../../../components/ErrorState.astro';
import { isValidContractId } from '../../../lib/contracts';
import { listEvents, ApiError, API_TIMEOUT } from '../../../lib/api';
import { probeContractOnChain } from '../../../lib/soroban';
import { truncate, relativeTime, stellarExpertBase, tryFormatJson } from '../../../lib/format';
import { ErrorType, getErrorState, classifyError } from '../../../lib/errors';
import type { ErrorState as ErrorStateType } from '../../../lib/errors';
import type { Network, SorobanEvent } from '../../../lib/types';

const { address } = Astro.params as { address: string };
const rawNetwork = Astro.url.searchParams.get('network');
const network: Network = rawNetwork === 'mainnet' ? 'mainnet' : 'testnet';
const topic0Filter = Astro.url.searchParams.get('topic0') ?? '';
const ledgerFrom = Astro.url.searchParams.get('ledgerFrom') ?? '';
const ledgerTo = Astro.url.searchParams.get('ledgerTo') ?? '';
const cursor = Astro.url.searchParams.get('cursor') ?? '';
const filtered = Boolean(topic0Filter || ledgerFrom || ledgerTo);

let events: SorobanEvent[] = [];
let hasMore = false;
let nextCursor: string | null = null;
let errorState = null as ErrorStateType | null;

if (!isValidContractId(address)) {
  errorState = {
    type: ErrorType.NOT_FOUND,
    title: "That doesn't look like a Stellar contract address",
    message:
      'A Soroban contract address is a 56-character string starting with C (for example C…) and ends in a valid checksum. Double-check for typos, copy the full address, and search again.',
    actionText: 'Back to search',
    actionUrl: '/',
    retryable: false,
  };
} else {
  try {
    const result = await listEvents({
      contractId: address,
      network,
      topic0: topic0Filter || undefined,
      ledgerFrom: ledgerFrom ? Number(ledgerFrom) : undefined,
      ledgerTo: ledgerTo ? Number(ledgerTo) : undefined,
      cursor: cursor || undefined,
      limit: 25,
    });

    events = result.events;
    hasMore = result.has_more;
    nextCursor = result.next_cursor;

    // No events at all: distinguish "no events yet" (quiet, but being watched
    // live) from "not indexed yet" (emitting on-chain, Trident hasn't caught
    // up) via a best-effort Soroban RPC probe. Only probe unbrowsed contracts.
    if (events.length === 0 && !cursor && !filtered) {
      const probe = await probeContractOnChain(network, address);
      if (probe.status === 'has_events') {
        errorState = getErrorState(ErrorType.INDEXER_BEHIND, {
          address,
          currentLedger: 'checking',
          lastIndexedLedger: 'unknown',
        });
      } else {
        errorState = {
          type: ErrorType.NO_DATA,
          title: 'No events yet',
          message:
            'Trident has not recorded any events for this contract yet. If it was just deployed, its events will appear here as soon as it emits one — this page is also streaming live, so nothing will be missed.',
          actionText: 'Back to search',
          actionUrl: '/',
          retryable: true,
        };
      }
    }
    // Empty result with filters
    else if (events.length === 0 && (topic0Filter || ledgerFrom || ledgerTo)) {
      errorState = getErrorState(ErrorType.EMPTY_RESULT, {
        filter: topic0Filter || `ledgers ${ledgerFrom}-${ledgerTo}`,
        clearUrl: `/contract/${address}?network=${network}`,
      });
    }
  } catch (err) {
    const error = err instanceof Error ? err : new Error(String(err));

    // lib/api throws ApiError with a real, structured .status on any non-2xx
    // response, so the status is read directly rather than parsed back out of
    // the message. ApiError's message comes from the API's own JSON error
    // envelope and is arbitrary server text, so it cannot be relied on to
    // contain "API <code>" (or the "not found"/"timeout" substrings
    // classifyError also looks for). A plain Error simply has no .status.
    const statusCode = err instanceof ApiError ? String(err.status) : undefined;

    let errorType = classifyError(error, statusCode ? Number(statusCode) : undefined);

    // fetchWithTimeout aborts via AbortController, which surfaces as a
    // DOMException named AbortError rather than anything ApiError-shaped.
    if (error.name === 'AbortError') {
      errorType = ErrorType.TIMEOUT;
    }

    errorState = getErrorState(errorType, {
      error,
      statusCode,
      timeout: API_TIMEOUT / 1000,
      address,
    });
  }
}

// Collect distinct topic_0 values for the filter dropdown
const distinctTypes = [...new Set(events.map((e) => e.topics[0] ?? e.event_type))].sort();

// OG meta
const shortAddr = truncate(address);
const ogTitle = `Events for ${shortAddr} on Stellar ${network.charAt(0).toUpperCase() + network.slice(1)}`;
const latestEvent = events[0];
const ogDescription = latestEvent
  ? `Events indexed for this contract. Latest: ${latestEvent.topics[0] ?? latestEvent.event_type} at ledger ${latestEvent.ledger_sequence}.`
  : `Soroban contract events on Stellar ${network}.`;

const expertBase = stellarExpertBase(network);

// Build filter URL helper
function filterUrl(overrides: Record<string, string>): string {
  const params = new URLSearchParams({
    network,
    ...(topic0Filter ? { topic0: topic0Filter } : {}),
    ...(ledgerFrom ? { ledgerFrom } : {}),
    ...(ledgerTo ? { ledgerTo } : {}),
  });
  for (const [k, v] of Object.entries(overrides)) {
    if (v) params.set(k, v);
    else params.delete(k);
  }
  return `?${params.toString()}`;
}
---

<Base
  title={`Events — ${shortAddr}`}
  description={ogDescription}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
>
  <!-- Breadcrumb -->
  <nav class="text-xs text-gray-500 mb-6 flex items-center gap-1.5" aria-label="Breadcrumb">
    <a href={`/explorer?network=${network}`} class="hover:text-white">Explorer</a>
    <span>/</span>
    <span class="text-gray-300 font-mono" title={address}>{shortAddr}</span>
  </nav>

  <!-- Contract header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center gap-3">
    <div class="flex-1 min-w-0">
      <h1 class="text-xl font-bold text-white flex items-center gap-2 flex-wrap">
        <span class="font-mono text-indigo-300 break-all" id="contract-address">{address}</span>
      </h1>
      <div class="mt-1 flex gap-3 text-xs text-gray-400">
        <a
          href={`${expertBase}/contract/${address}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white underline underline-offset-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded"
        >
          Stellar Expert ↗
        </a>
        <span
          class={`px-2 py-0.5 rounded-full text-xs font-medium ${
            network === 'mainnet'
              ? 'bg-amber-900/40 text-amber-400'
              : 'bg-blue-900/40 text-blue-400'
          }`}
        >
          {network}
        </span>
        <span id="stream-status" class="hidden items-center gap-1.5">
          <span id="stream-dot" class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>
          <span id="stream-label">Connecting</span>
        </span>
      </div>
    </div>

    <button
      id="copy-address"
      class="text-xs px-3 py-1.5 rounded bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white transition-colors shrink-0 focus:outline-none focus:ring-2 focus:ring-indigo-500"
      data-address={address}
    >
      Copy address
    </button>
  </div>

  <!-- Live stream status -->
  {isValidContractId(address) && !filtered && (
    <div class="mb-5 flex items-center justify-between gap-3 flex-wrap">
      <span id="stream-status" data-status="connecting" class="inline-flex items-center gap-2" aria-live="polite"></span>
      <span id="stream-notice" aria-live="polite"></span>
    </div>
  )}

  <!-- Error state -->
  {errorState && !events.length && (
    <ErrorState error={errorState} />
  )}

  <!-- Filters (only show if we have data or are paginating) -->
  {(events.length > 0 || cursor) && (
    <form method="get" class="mb-5 flex flex-wrap gap-3 items-end text-sm">
      <input type="hidden" name="network" value={network} />

      <div class="flex flex-col gap-1">
        <label for="topic0-filter" class="text-xs text-gray-400">Event type</label>
        <select
          id="topic0-filter"
          name="topic0"
          class="px-3 py-1.5 rounded bg-gray-800 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
        >
          <option value="">All types</option>
          {distinctTypes.map((t) => (
            <option value={t} selected={t === topic0Filter}>{t}</option>
          ))}
        </select>
      </div>

      <div class="flex flex-col gap-1">
        <label for="ledger-from" class="text-xs text-gray-400">Ledger from</label>
        <input
          id="ledger-from"
          type="number"
          name="ledgerFrom"
          value={ledgerFrom}
          min="1"
          placeholder="e.g. 55000"
          class="w-32 px-3 py-1.5 rounded bg-gray-800 border border-gray-700 text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="ledger-to" class="text-xs text-gray-400">Ledger to</label>
        <input
          id="ledger-to"
          type="number"
          name="ledgerTo"
          value={ledgerTo}
          min="1"
          placeholder="e.g. 56000"
          class="w-32 px-3 py-1.5 rounded bg-gray-800 border border-gray-700 text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
        />
      </div>

      <button
        type="submit"
        class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded text-white font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
      >
        Apply
      </button>

      {(topic0Filter || ledgerFrom || ledgerTo) && (
        <a
          href={filterUrl({ topic0: '', ledgerFrom: '', ledgerTo: '' })}
          class="px-4 py-1.5 rounded bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          Clear
        </a>
      )}
    </form>
  )}

  <!-- Events table -->
  {events.length > 0 ? (
    <div>
      <div class="overflow-x-auto rounded-lg border border-gray-800">
        <table class="w-full text-sm">
          <thead class="bg-gray-900 text-xs text-gray-400 uppercase tracking-wide">
            <tr>
              <th class="px-4 py-3 text-left">Time</th>
              <th class="px-4 py-3 text-left">Ledger</th>
              <th class="px-4 py-3 text-left">Type</th>
              <th class="px-4 py-3 text-left hidden md:table-cell">Topic 1</th>
              <th class="px-4 py-3 text-left hidden lg:table-cell">Tx Hash</th>
              <th class="px-4 py-3 text-left hidden xl:table-cell">Data</th>
            </tr>
          </thead>
          <tbody id="events-tbody" class="divide-y divide-gray-800">
            {events.map((e) => (
              <tr
                class="hover:bg-gray-900/60 cursor-pointer transition-colors"
                data-href={`/contract/${address}/event/${e.id}?network=${network}`}
              >
                <td class="px-4 py-3 text-gray-400 whitespace-nowrap text-xs" title={e.ledger_timestamp}>
                  {relativeTime(e.ledger_timestamp)}
                </td>
                <td class="px-4 py-3 font-mono text-gray-300 text-xs">
                  <a
                    href={`?${new URLSearchParams({ network, ledgerFrom: String(e.ledger_sequence), ledgerTo: String(e.ledger_sequence) })}`}
                    class="hover:text-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded"
                  >
                    {e.ledger_sequence}
                  </a>
                </td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 rounded-full text-xs bg-indigo-900/50 text-indigo-300 font-medium">
                    {e.topics[0] ?? e.event_type}
                  </span>
                </td>
                <td class="px-4 py-3 font-mono text-gray-400 text-xs truncate max-w-[180px] hidden md:table-cell" title={e.topics[1]}>
                  {e.topics[1] ? truncate(e.topics[1], 12, 8) : '—'}
                </td>
                <td class="px-4 py-3 hidden lg:table-cell">
                  <a
                    href={`${expertBase}/tx/${e.transaction_hash}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs text-gray-400 hover:text-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded"
                    title={e.transaction_hash}
                  >
                    {truncate(e.transaction_hash, 8, 6)}
                  </a>
                </td>
                <td class="px-4 py-3 hidden xl:table-cell font-mono text-xs text-gray-500 max-w-[200px] truncate" title={e.data}>
                  {e.data ? tryFormatJson(e.data).slice(0, 60) : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="mt-4 flex items-center justify-between">
        {cursor ? (
          <a
            href={filterUrl({ cursor: '' })}
            class="text-sm text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded"
          >
            ← Back to first page
          </a>
        ) : <span />}

        {hasMore && nextCursor && (
          <div>
            <a
              id="load-more-link"
              href={filterUrl({ cursor: nextCursor })}
              class="px-5 py-2 rounded bg-gray-800 hover:bg-gray-700 text-white text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
              data-cursor={nextCursor}
            >
              Load more
            </a>
          </div>
        )}
      </div>
    </div>
  ) : null}
</Base>

<script>
  import '../../../lib/contract-sse';
</script>

<script>
  // Copy address button
  const copyBtn = document.getElementById('copy-address') as HTMLButtonElement | null;
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const addr = copyBtn.dataset.address ?? '';
      try {
        await navigator.clipboard.writeText(addr);
        const orig = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => { copyBtn.textContent = orig; }, 1500);
      } catch { /* clipboard unavailable */ }
    });
  }

  // JS "Load more" — appends rows instead of navigating. Row click-to-navigate
  // for these appended rows is handled by the delegated listener in
  // lib/contract-sse (it matches any tr[data-href], not just ones present at
  // page load).
  const loadMoreLink = document.getElementById('load-more-link') as HTMLAnchorElement | null;
  if (loadMoreLink) {
    loadMoreLink.addEventListener('click', async (e) => {
      e.preventDefault();
      loadMoreLink.textContent = 'Loading…';
      loadMoreLink.setAttribute('disabled', '');

      const params = new URLSearchParams(window.location.search);
      const network = params.get('network') ?? 'testnet';
      const contractId = window.location.pathname.split('/')[2];
      const apiParams = new URLSearchParams({ network, contractId });
      if (params.get('topic0')) apiParams.set('topic0', params.get('topic0')!);
      if (params.get('ledgerFrom')) apiParams.set('ledgerFrom', params.get('ledgerFrom')!);
      if (params.get('ledgerTo')) apiParams.set('ledgerTo', params.get('ledgerTo')!);
      apiParams.set('cursor', loadMoreLink.dataset.cursor!);

      try {
        const res = await fetch(`/api/events.json?${apiParams}`);
        if (!res.ok) throw new Error('fetch failed');
        const data: { events: any[]; has_more: boolean; next_cursor: string | null } = await res.json();

        const tbody = document.getElementById('events-tbody');
        if (tbody && data.events.length) {
          for (const ev of data.events) {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-gray-900/60 cursor-pointer transition-colors';
            tr.dataset.href = `/contract/${encodeURIComponent(ev.contract_id)}/event/${encodeURIComponent(ev.id)}?network=${network}`;

            const time = document.createElement('td');
            time.className = 'px-4 py-3 text-gray-400 whitespace-nowrap text-xs';
            time.textContent = new Date(ev.ledger_timestamp).toLocaleTimeString();
            tr.append(time);

            const seq = document.createElement('td');
            seq.className = 'px-4 py-3 font-mono text-gray-300 text-xs';
            seq.textContent = String(ev.ledger_sequence);
            tr.append(seq);

            const typeTd = document.createElement('td');
            typeTd.className = 'px-4 py-3';
            const badge = document.createElement('span');
            badge.className = 'px-2 py-0.5 rounded-full text-xs bg-indigo-900/50 text-indigo-300 font-medium';
            badge.textContent = ev.topics?.[0] ?? ev.event_type;
            typeTd.append(badge);
            tr.append(typeTd);

            const topic1 = document.createElement('td');
            topic1.className = 'px-4 py-3 font-mono text-gray-400 text-xs truncate max-w-[180px] hidden md:table-cell';
            topic1.textContent = ev.topics?.[1] ? `${String(ev.topics[1]).slice(0, 20)}...` : '—';
            tr.append(topic1);

            const txTd = document.createElement('td');
            txTd.className = 'px-4 py-3 hidden lg:table-cell';
            const txLink = document.createElement('a');
            txLink.href = `${network === 'mainnet' ? 'https://stellar.expert/explorer/public' : 'https://stellar.expert/explorer/testnet'}/tx/${encodeURIComponent(ev.transaction_hash)}`;
            txLink.target = '_blank';
            txLink.rel = 'noopener noreferrer';
            txLink.className = 'font-mono text-xs text-gray-400 hover:text-indigo-300';
            txLink.textContent = `${String(ev.transaction_hash).slice(0, 8)}...${String(ev.transaction_hash).slice(-6)}`;
            txTd.append(txLink);
            tr.append(txTd);

            const dataTd = document.createElement('td');
            dataTd.className = 'px-4 py-3 hidden xl:table-cell font-mono text-xs text-gray-500 max-w-[200px] truncate';
            dataTd.textContent = ev.data ? String(ev.data).slice(0, 60) : '—';
            tr.append(dataTd);

            tbody.appendChild(tr);
          }
        }

        if (data.has_more && data.next_cursor) {
          loadMoreLink.dataset.cursor = data.next_cursor;
          loadMoreLink.textContent = 'Load more';
          loadMoreLink.removeAttribute('disabled');
          // Update no-JS href too
          const url = new URL(window.location.href);
          url.searchParams.set('cursor', data.next_cursor);
          loadMoreLink.href = url.pathname + url.search;
        } else {
          loadMoreLink.remove();
        }
      } catch {
        loadMoreLink.textContent = 'Load more';
        loadMoreLink.removeAttribute('disabled');
      }
    });
  }
</script>
